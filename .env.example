# App
APP_NAME="Team Battle CTF"
DEBUG=false
SECRET_KEY=change-me-to-a-random-32-char-string

# Database
POSTGRES_USER=ctf
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ctfdb
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
TEST_POSTGRES_DB=ctf_test

# Redis
REDIS_URL=redis://redis:6379/0

# Proxy trust (Docker internal CIDR — do not change unless you change Compose network)
TRUSTED_PROXY_NETWORK=172.28.0.0/16

# Auth limits
SESSION_TTL_SECONDS=43200
LOGIN_IP_LIMIT=10
LOGIN_USERNAME_LIMIT=5
REGISTER_IP_LIMIT=5
LOGIN_WINDOW_SECONDS=900
REGISTER_WINDOW_SECONDS=3600

# Public Caddy ports
HTTP_PORT=80
HTTPS_PORT=443
